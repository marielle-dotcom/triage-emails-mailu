# Système de triage – étape 1 (filtre After-Queue, voir triage/).
# Réception port 25 : le message accepté est confié au filtre (192.168.203.250:10035).
# Étape 4 : alias développés après le filtre (no_address_mappings ici, pas sur 10036),
# comme le recommande le FILTER_README de Postfix ; les alertes vers un alias fonctionnent.
smtp/inet = smtp inet n - n - - smtpd -o content_filter=triage:[192.168.203.250]:10035 -o receive_override_options=no_address_mappings
# Transport vers le filtre : un destinataire par livraison (destination_recipient_limit dans postfix.cf).
triage/unix = triage unix - - n - 10 smtp -o syslog_name=postfix-triage -o smtp_tls_security_level=none -o smtp_send_xforward_command=no -o max_use=20
# Réinjection : uniquement depuis le filtre (.250) et l'outil de quarantaine (.251, libérations),
# sans milter ni content_filter ; les alias y sont développés.
10036/inet = 10036 inet n - n - - smtpd -o syslog_name=postfix-reinject -o content_filter= -o receive_override_options=no_unknown_recipient_checks,no_header_body_checks,no_milters -o smtpd_milters= -o mynetworks=192.168.203.250/32,192.168.203.251/32 -o smtpd_client_restrictions=permit_mynetworks,reject -o smtpd_helo_restrictions= -o smtpd_sender_restrictions= -o smtpd_relay_restrictions=permit_mynetworks,reject -o smtpd_recipient_restrictions=permit_mynetworks,reject -o smtpd_data_restrictions= -o smtpd_end_of_data_restrictions= -o smtpd_sasl_auth_enable=no -o smtpd_tls_security_level=none -o smtpd_hard_error_limit=1000 -o smtpd_client_connection_count_limit=0 -o smtpd_client_connection_rate_limit=0
