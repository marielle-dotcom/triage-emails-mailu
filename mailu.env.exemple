# Mailu 2024.06 - anac.lab
# Clé secrète (ne pas partager)
SECRET_KEY=A_GENERER_openssl_rand_hex_16

# Sous-réseau docker interne de Mailu
SUBNET=192.168.203.0/24

# Domaine principal et nom d'hôte du serveur
DOMAIN=anac.lab
HOSTNAMES=mail.anac.lab
POSTMASTER=admin

# TLS : cert = certificats fournis dans ./certs (auto-signés ici)
TLS_FLAVOR=cert

# Ports exposés (2024.06 : TLS implicite uniquement par défaut ; ajouter 587,143,110 pour STARTTLS)
PORTS=25,80,443,465,993,995,4190

# Limitation des tentatives d'authentification
AUTH_RATELIMIT_IP=5/hour
AUTH_RATELIMIT_USER=50/day
DISABLE_STATISTICS=True

###################################
# Fonctionnalités optionnelles
###################################
ADMIN=true
WEBMAIL=roundcube
API=false
WEBDAV=none
ANTIVIRUS=clamav
SCAN_MACROS=true

###################################
# Paramètres mail
###################################
MESSAGE_SIZE_LIMIT=50000000
MESSAGE_RATELIMIT=200/day
RELAYNETS=
RELAYHOST=
RECIPIENT_DELIMITER=+
DMARC_RUA=admin
DMARC_RUF=admin
WELCOME=false
WELCOME_SUBJECT=Bienvenue sur votre nouvelle boîte mail
WELCOME_BODY=Bienvenue sur votre nouvelle boîte mail.
FETCHMAIL_ENABLED=false
FETCHMAIL_DELAY=600
DEFAULT_QUOTA=1000000000
DEFAULT_SPAM_THRESHOLD=80
REJECT_UNLISTED_RECIPIENT=

###################################
# Interface web
###################################
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail
WEBROOT_REDIRECT=/webmail
WEBSITE=https://mail.anac.lab
SITENAME=Mailu Lab
LOGO_URL=
LOGO_BACKGROUND=

###################################
# Avancé
###################################
COMPOSE_PROJECT_NAME=mailu
CREDENTIAL_ROUNDS=12
REAL_IP_HEADER=
REAL_IP_FROM=
LOG_LEVEL=WARNING
TZ=Europe/Paris
