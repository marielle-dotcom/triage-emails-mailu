  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Messages analysés",
      "description": "Messages entrants traités par le filtre sur la période.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "triage-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "triage-pg"
          },
          "rawSql": "SELECT count(*) AS \"messages\" FROM decisions WHERE $__timeFilter(recu_le)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
